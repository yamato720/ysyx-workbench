*.*
*
!*/

# Ignore build artifact and generated directories
target/
generated-dpi/
generated-ip/
generated/
generated-pipeline-dpi/
intermediate/
out/
.idea/

# Whitelist tracked file types
!Makefile
!*.mk
!*.[cSh]
!*.v
!*.cc
!*.cpp
!*.scala
!*.sbt
!*.env
!/fpga/*/link.cfg
!.gitignore
!.gitkeep
!*.md
!*.tcl
!*.sv
!*.sh
!scripts/performance-summary.sh

# Tool-generated trees can contain whitelisted RTL, Tcl, and Markdown files.
# Keep these exclusions after the file-type whitelist above.
/.Xil/
/.gen/
/.ipcache/
/.metals/
/_x/
/fpga/common/build/
/constructions/
/project/metals.sbt
/project/project/

# 保留 FPGA IP 生成器的固定 source/generated 目录骨架，仅允许占位文件进入 Git。
!/fpga-ip-generator/**/generated/
!/fpga-ip-generator/**/generated/*/
!/fpga-ip-generator/**/generated/*/.gitkeep
