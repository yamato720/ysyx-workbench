.PHONY: build-host build-simulation-host build-input-fpga-host encode cuperflow-encode \
	cuperflow-encode-stats \
	cuper-a-test encoding-html-test cuperflow-encoding-html-test encoding-test \
	cuperflow-timing cuperflow-timing-model cuperflow-timing-html-test \
	dataflow-sim hisparse-preprocess-benchmark \
	hispmv-preprocess-benchmark input-html-test run

build-host: $(HOST_BIN)

build-simulation-host:
	@test -n "$(strip $(CONSTRUCTION_DIR))" || { echo 'build-simulation-host 缺少 CONSTRUCTION_DIR' >&2; exit 2; }
ifeq ($(SPMV_CUPERFLOW_RTL),1)
	@test -s "$(MODEL_DIR)/VSpmvCuperflowInputTop.h"
	@test -s "$(MODEL_DIR)/libVSpmvCuperflowInputTop.a"
	@test -s "$(MODEL_DIR)/libverilated.a"
	@$(MAKE) --no-print-directory "$(HOST_BIN)" CONSTRUCTION_DIR="$(CONSTRUCTION_DIR)" BUILD_DIR="$(BUILD_DIR)"
	@{ \
		printf '%s\n' 'HOST_FORMAT=15'; \
		printf 'CONFIG_FQCN=%s\n' "$$(sed -n 's/^CONFIG_FQCN=//p' "$(SPMV_PROFILE_FILE)")"; \
		printf '%s\n' 'ACCELERATOR_HOST_KIND=spmv' 'ACCELERATOR_HOST_ABI=spmv-cuperflow-rtl-v1' 'PROTOCOL_ABI=spmv-cuperflow-rtl-v1'; \
		for key in SPMV_CUPERFLOW_HBM_PC_COUNT SPMV_CUPERFLOW_HBM_BASE SPMV_CUPERFLOW_HBM_BYTES SPMV_CUPERFLOW_X_REGION_BYTES \
			SPMV_CUPERFLOW_AXI_ADDR_WIDTH SPMV_CUPERFLOW_AXI_DATA_WIDTH SPMV_CUPERFLOW_AXI_ID_WIDTH \
			SPMV_CUPERFLOW_MAX_OUTSTANDING_BURSTS SPMV_CUPERFLOW_X_WINDOW_SIZE SPMV_CUPERFLOW_X_REPLICA_COUNT \
			SPMV_CUPERFLOW_X_ELEMENT_WIDTH SPMV_CUPERFLOW_X_DECODER_LANES SPMV_FP64_MUL_INTERFACE SPMV_FP64_MUL_PROVIDER \
			SPMV_FP64_MUL_LATENCY SPMV_FP64_MUL_II SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH SPMV_FP64_MUL_LANES \
			SPMV_FP64_MUL_CORE_COUNT SPMV_FP64_MUL_TOTAL_LANES SPMV_PERFORMANCE_HTML SPMV_PIPELINE_HTML; do \
			printf '%s=%s\n' "$$key" "$$(sed -n "s/^$$key=//p" "$(SPMV_PROFILE_FILE)" | tail -n 1)"; \
		done; \
	} > "$(BUILD_DIR)/host.env"
else
	@test -s "$(MODEL_DIR)/VSpmvInputTop.h"
	@test -s "$(MODEL_DIR)/libVSpmvInputTop.a"
	@test -s "$(MODEL_DIR)/libverilated.a"
	@$(MAKE) --no-print-directory "$(HOST_BIN)" CONSTRUCTION_DIR="$(CONSTRUCTION_DIR)" BUILD_DIR="$(BUILD_DIR)"
	@{ \
		printf '%s\n' 'HOST_FORMAT=13'; \
		printf 'CONFIG_FQCN=%s\n' "$$(sed -n 's/^CONFIG_FQCN=//p' "$(SPMV_PROFILE_FILE)")"; \
		printf '%s\n' 'ACCELERATOR_HOST_KIND=spmv' 'ACCELERATOR_HOST_ABI=spmv-input-report-v13' 'PROTOCOL_ABI=spmv-input-windowed-v12'; \
		printf 'SPMV_INPUT_A_READER_COUNT=%s\nSPMV_INPUT_X_READER_COUNT=%s\nSPMV_INPUT_CTRL_READER_COUNT=%s\n' "$(SPMV_INPUT_A_READER_COUNT)" "$(SPMV_INPUT_X_READER_COUNT)" "$(SPMV_INPUT_CTRL_READER_COUNT)"; \
		printf 'SPMV_INPUT_HBM_CHANNEL_COUNT=%s\nSPMV_INPUT_HBM_BASE=%s\nSPMV_INPUT_HBM_BYTES=%s\nSPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES=%s\n' "$(SPMV_INPUT_HBM_CHANNEL_COUNT)" "$(SPMV_INPUT_HBM_BASE)" "$(SPMV_INPUT_HBM_BYTES)" "$(SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES)"; \
		printf 'SPMV_INPUT_AXI_ADDR_WIDTH=%s\nSPMV_INPUT_AXI_DATA_WIDTH=%s\nSPMV_INPUT_AXI_ID_WIDTH=%s\nSPMV_INPUT_MAX_OUTSTANDING_BURSTS=%s\n' "$(SPMV_INPUT_AXI_ADDR_WIDTH)" "$(SPMV_INPUT_AXI_DATA_WIDTH)" "$(SPMV_INPUT_AXI_ID_WIDTH)" "$(SPMV_INPUT_MAX_OUTSTANDING_BURSTS)"; \
		printf 'SPMV_INPUT_CONSUMER_COUNT=%s\nSPMV_INPUT_X_BROADCAST=%s\nSPMV_INPUT_CTRL_BROADCAST=%s\n' "$(SPMV_INPUT_CONSUMER_COUNT)" "$(SPMV_INPUT_X_BROADCAST)" "$(SPMV_INPUT_CTRL_BROADCAST)"; \
		printf 'SPMV_INPUT_X_WINDOW_SIZE=%s\nSPMV_INPUT_X_REPLICA_COUNT=%s\nSPMV_INPUT_X_BANK_COUNT=%s\nSPMV_INPUT_X_ELEMENT_WIDTH=%s\nSPMV_INPUT_X_PORT_SCHEDULE=%s\nSPMV_INPUT_X_WRITE_LANES=%s\nSPMV_INPUT_X_OVERLAP_LANES=%s\n' "$(SPMV_INPUT_X_WINDOW_SIZE)" "$(SPMV_INPUT_X_REPLICA_COUNT)" "$(SPMV_INPUT_X_BANK_COUNT)" "$(SPMV_INPUT_X_ELEMENT_WIDTH)" "$(SPMV_INPUT_X_PORT_SCHEDULE)" "$(SPMV_INPUT_X_WRITE_LANES)" "$(SPMV_INPUT_X_OVERLAP_LANES)"; \
		printf 'SPMV_CUPER_SLOT_ABI=%s\nSPMV_CUPER_SLOT_COLUMN_BITS=%s\nSPMV_CUPER_SLOT_TAG_BITS=%s\nSPMV_CUPER_SLOT_ROW_BITS=%s\n' "$(SPMV_CUPER_SLOT_ABI)" "$(SPMV_CUPER_SLOT_COLUMN_BITS)" "$(SPMV_CUPER_SLOT_TAG_BITS)" "$(SPMV_CUPER_SLOT_ROW_BITS)"; \
		printf 'SPMV_FP64_MUL_INTERFACE=%s\nSPMV_FP64_MUL_LATENCY=%s\nSPMV_FP64_MUL_II=%s\nSPMV_FP64_MUL_RESPONSE_FIFO_DEPTH=%s\nSPMV_FP64_MUL_LANES=%s\nSPMV_FP64_MUL_CORE_COUNT=%s\nSPMV_FP64_MUL_TOTAL_LANES=%s\n' "$(SPMV_FP64_MUL_INTERFACE)" "$(SPMV_FP64_MUL_LATENCY)" "$(SPMV_FP64_MUL_II)" "$(SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH)" "$(SPMV_FP64_MUL_LANES)" "$(SPMV_FP64_MUL_CORE_COUNT)" "$(SPMV_FP64_MUL_TOTAL_LANES)"; \
		printf 'SPMV_PERFORMANCE_HTML=%s\nSPMV_PIPELINE_HTML=%s\n' "$(SPMV_PERFORMANCE_HTML)" "$(SPMV_PIPELINE_HTML)"; \
	} > "$(BUILD_DIR)/host.env"
endif

build-input-fpga-host:
	@test -n "$(strip $(CONSTRUCTION_DIR))" || { echo 'build-input-fpga-host 缺少 CONSTRUCTION_DIR' >&2; exit 2; }
	@test "$(call spmv_profile_value,ACCELERATOR_HOST_ABI)" = spmv-input-u55c-runtime-v1
	@test "$(call spmv_profile_value,PROTOCOL_ABI)" = spmv-input-u55c-windowed-v1
	@$(MAKE) --no-print-directory "$(HOST_BIN)" SPMV_INPUT_XRT=1 CONSTRUCTION_DIR="$(CONSTRUCTION_DIR)" BUILD_DIR="$(BUILD_DIR)"
	@{ \
		printf '%s\n' 'HOST_FORMAT=14'; \
		for key in CONFIG_FQCN ACCELERATOR_HOST_KIND ACCELERATOR_HOST_ABI PROTOCOL_ABI SPMV_XRT_KERNEL \
			SPMV_INPUT_HBM_MASTER_COUNT SPMV_INPUT_A_READER_COUNT SPMV_INPUT_X_READER_COUNT SPMV_INPUT_CTRL_READER_COUNT \
			SPMV_INPUT_HBM_CHANNEL_COUNT SPMV_INPUT_HBM_BASE SPMV_INPUT_HBM_BYTES SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES \
			SPMV_INPUT_AXI_ADDR_WIDTH SPMV_INPUT_AXI_DATA_WIDTH SPMV_INPUT_AXI_ID_WIDTH SPMV_INPUT_MAX_OUTSTANDING_BURSTS \
			SPMV_INPUT_CONSUMER_COUNT SPMV_INPUT_X_BROADCAST SPMV_INPUT_CTRL_BROADCAST SPMV_INPUT_X_WINDOW_SIZE \
			SPMV_INPUT_X_REPLICA_COUNT SPMV_INPUT_X_BANK_COUNT SPMV_INPUT_X_ELEMENT_WIDTH SPMV_INPUT_X_PORT_SCHEDULE \
			SPMV_INPUT_X_WRITE_LANES SPMV_INPUT_X_OVERLAP_LANES SPMV_CUPER_SLOT_ABI SPMV_CUPER_SLOT_COLUMN_BITS \
			SPMV_CUPER_SLOT_TAG_BITS SPMV_CUPER_SLOT_ROW_BITS SPMV_FP64_MUL_INTERFACE SPMV_FP64_MUL_PROVIDER \
			SPMV_FP64_MUL_LATENCY SPMV_FP64_MUL_II SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH SPMV_FP64_MUL_LANES \
			SPMV_FP64_MUL_CORE_COUNT SPMV_FP64_MUL_TOTAL_LANES FPGA_BOARD FPGA_PLATFORM FPGA_CLOCK_MHZ; do \
			printf '%s=%s\n' "$$key" "$$(sed -n "s/^$$key=//p" "$(SPMV_PROFILE_FILE)" | tail -n 1)"; \
		done; \
	} > "$(BUILD_DIR)/host.env"

