SHELL := /bin/bash

CXX ?= g++
CXXFLAGS ?= -std=c++17 -O2 -Wall -Wextra -Wpedantic -Werror -ffp-contract=off
CPPFLAGS ?=
LDLIBS ?=

BUILD_DIR ?= $(CURDIR)/build
HOST_BIN := $(BUILD_DIR)/spmv-host
ENCODING_TEST_BIN := $(BUILD_DIR)/encoding-test
ENCODING_SOURCES := encoding/encoder.cpp encoding/cuper/cuper.cpp encoding/cuper/report.cpp \
	encoding/cuper/vector_report.cpp
HOST_SOURCES := host.cpp input/input_simulation.cpp golden.cpp $(ENCODING_SOURCES)
HOST_OBJECTS := $(addprefix $(BUILD_DIR)/,$(HOST_SOURCES:.cpp=.o))
ENCODING_OBJECTS := $(addprefix $(BUILD_DIR)/,$(ENCODING_SOURCES:.cpp=.o))
ENCODING_TEST_OBJECT := $(BUILD_DIR)/encoding/encoding_test.o
DEPFILES := $(sort $(HOST_OBJECTS:.o=.d) $(ENCODING_TEST_OBJECT:.o=.d))
ENCODING ?= cuper
ENCODING_TEST_DATASET ?= n512
ACCELERATOR_DATA_ROOT ?= $(abspath $(CURDIR)/../data)
SPMV_GOLDEN_DIR := $(BUILD_DIR)/golden
SPMV_ENCODING_REPORT_DIR ?= $(BUILD_DIR)/encoding
CPPFLAGS += -DACCELERATOR_SIM_DEFAULT_DATA_ROOT=\"$(ACCELERATOR_DATA_ROOT)\"

SPMV_PROFILE_FILE ?= $(if $(strip $(CONSTRUCTION_PROFILE)),$(CONSTRUCTION_PROFILE),$(if $(strip $(CONSTRUCTION_DIR)),$(CONSTRUCTION_DIR)/profile.env,))
spmv_profile_value = $(shell test -n "$(SPMV_PROFILE_FILE)" && test -f "$(SPMV_PROFILE_FILE)" && sed -n 's/^$(1)=//p' "$(SPMV_PROFILE_FILE)" | tail -n 1)

SPMV_INPUT_A_READER_COUNT ?= $(call spmv_profile_value,SPMV_INPUT_A_READER_COUNT)
SPMV_INPUT_X_READER_COUNT ?= $(call spmv_profile_value,SPMV_INPUT_X_READER_COUNT)
SPMV_INPUT_HBM_CHANNEL_COUNT ?= $(call spmv_profile_value,SPMV_INPUT_HBM_CHANNEL_COUNT)
SPMV_INPUT_HBM_BASE ?= $(call spmv_profile_value,SPMV_INPUT_HBM_BASE)
SPMV_INPUT_HBM_BYTES ?= $(call spmv_profile_value,SPMV_INPUT_HBM_BYTES)
SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES ?= $(call spmv_profile_value,SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES)
SPMV_INPUT_AXI_ADDR_WIDTH ?= $(call spmv_profile_value,SPMV_INPUT_AXI_ADDR_WIDTH)
SPMV_INPUT_AXI_DATA_WIDTH ?= $(call spmv_profile_value,SPMV_INPUT_AXI_DATA_WIDTH)
SPMV_INPUT_AXI_ID_WIDTH ?= $(call spmv_profile_value,SPMV_INPUT_AXI_ID_WIDTH)
SPMV_INPUT_MAX_OUTSTANDING_BURSTS ?= $(call spmv_profile_value,SPMV_INPUT_MAX_OUTSTANDING_BURSTS)
SPMV_INPUT_CONSUMER_COUNT ?= $(call spmv_profile_value,SPMV_INPUT_CONSUMER_COUNT)
SPMV_INPUT_X_BROADCAST ?= $(call spmv_profile_value,SPMV_INPUT_X_BROADCAST)
SPMV_INPUT_CTRL_READER_COUNT ?= $(call spmv_profile_value,SPMV_INPUT_CTRL_READER_COUNT)
SPMV_INPUT_CTRL_BROADCAST ?= $(call spmv_profile_value,SPMV_INPUT_CTRL_BROADCAST)
SPMV_INPUT_X_WINDOW_SIZE ?= $(call spmv_profile_value,SPMV_INPUT_X_WINDOW_SIZE)
SPMV_INPUT_X_REPLICA_COUNT ?= $(call spmv_profile_value,SPMV_INPUT_X_REPLICA_COUNT)
SPMV_INPUT_X_BANK_COUNT ?= $(call spmv_profile_value,SPMV_INPUT_X_BANK_COUNT)
SPMV_INPUT_X_ELEMENT_WIDTH ?= $(call spmv_profile_value,SPMV_INPUT_X_ELEMENT_WIDTH)
SPMV_CUPER_SLOT_ABI ?= $(call spmv_profile_value,SPMV_CUPER_SLOT_ABI)
SPMV_CUPER_SLOT_COLUMN_BITS ?= $(call spmv_profile_value,SPMV_CUPER_SLOT_COLUMN_BITS)
SPMV_CUPER_SLOT_TAG_BITS ?= $(call spmv_profile_value,SPMV_CUPER_SLOT_TAG_BITS)
SPMV_CUPER_SLOT_ROW_BITS ?= $(call spmv_profile_value,SPMV_CUPER_SLOT_ROW_BITS)
SPMV_FP64_MUL_INTERFACE ?= $(call spmv_profile_value,SPMV_FP64_MUL_INTERFACE)
SPMV_FP64_MUL_LATENCY ?= $(call spmv_profile_value,SPMV_FP64_MUL_LATENCY)
SPMV_FP64_MUL_II ?= $(call spmv_profile_value,SPMV_FP64_MUL_II)
SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH ?= $(call spmv_profile_value,SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH)
SPMV_FP64_MUL_LANES ?= $(call spmv_profile_value,SPMV_FP64_MUL_LANES)
SPMV_FP64_MUL_CORE_COUNT ?= $(call spmv_profile_value,SPMV_FP64_MUL_CORE_COUNT)
SPMV_FP64_MUL_TOTAL_LANES ?= $(call spmv_profile_value,SPMV_FP64_MUL_TOTAL_LANES)
SPMV_PERFORMANCE_HTML ?= $(call spmv_profile_value,SPMV_PERFORMANCE_HTML)
SPMV_PIPELINE_HTML ?= $(call spmv_profile_value,SPMV_PIPELINE_HTML)

# 未绑定 construction 时保留独立编码 smoke test 的默认输入布局；一旦绑定 profile，
# 上面的 ?= 会优先采用 Config 导出的值。
SPMV_INPUT_A_READER_COUNT ?= 16
SPMV_INPUT_X_READER_COUNT ?= 2
SPMV_INPUT_HBM_CHANNEL_COUNT ?= 16
SPMV_INPUT_HBM_BASE ?= 0x80000000
SPMV_INPUT_HBM_BYTES ?= 134217728
SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES ?= 4096
SPMV_INPUT_AXI_ADDR_WIDTH ?= 64
SPMV_INPUT_AXI_DATA_WIDTH ?= 512
SPMV_INPUT_AXI_ID_WIDTH ?= 4
SPMV_INPUT_MAX_OUTSTANDING_BURSTS ?= 2
SPMV_INPUT_CONSUMER_COUNT ?= 16
SPMV_INPUT_X_BROADCAST ?= 1
SPMV_INPUT_CTRL_READER_COUNT ?= 1
SPMV_INPUT_CTRL_BROADCAST ?= 1
SPMV_INPUT_X_WINDOW_SIZE ?= 8192
SPMV_INPUT_X_REPLICA_COUNT ?= 4
SPMV_INPUT_X_BANK_COUNT ?= 16
SPMV_INPUT_X_ELEMENT_WIDTH ?= 64
SPMV_CUPER_SLOT_ABI ?= cuper-a-slot-v3
SPMV_CUPER_SLOT_COLUMN_BITS ?= 13
SPMV_CUPER_SLOT_TAG_BITS ?= 3
SPMV_CUPER_SLOT_ROW_BITS ?= 16
SPMV_FP64_MUL_INTERFACE ?= arithmetic-req-resp-v1
SPMV_FP64_MUL_LATENCY ?= 4
SPMV_FP64_MUL_II ?= 1
SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH ?= 4
SPMV_FP64_MUL_LANES ?= 8
SPMV_FP64_MUL_CORE_COUNT ?= 16
SPMV_FP64_MUL_TOTAL_LANES ?= 128
SPMV_PERFORMANCE_HTML ?= 1
SPMV_PIPELINE_HTML ?= 1

export ACCELERATOR_DATA_ROOT SPMV_GOLDEN_DIR SPMV_ENCODING_REPORT_DIR mainargs \
	SPMV_INPUT_A_READER_COUNT SPMV_INPUT_X_READER_COUNT SPMV_INPUT_HBM_CHANNEL_COUNT \
	SPMV_INPUT_HBM_BASE SPMV_INPUT_HBM_BYTES SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES \
	SPMV_INPUT_AXI_ADDR_WIDTH SPMV_INPUT_AXI_DATA_WIDTH SPMV_INPUT_AXI_ID_WIDTH \
	SPMV_INPUT_MAX_OUTSTANDING_BURSTS \
	SPMV_INPUT_CONSUMER_COUNT SPMV_INPUT_X_BROADCAST \
	SPMV_INPUT_CTRL_READER_COUNT SPMV_INPUT_CTRL_BROADCAST \
	SPMV_INPUT_X_WINDOW_SIZE SPMV_INPUT_X_REPLICA_COUNT \
	SPMV_INPUT_X_BANK_COUNT SPMV_INPUT_X_ELEMENT_WIDTH \
	SPMV_CUPER_SLOT_ABI SPMV_CUPER_SLOT_COLUMN_BITS SPMV_CUPER_SLOT_TAG_BITS \
	SPMV_CUPER_SLOT_ROW_BITS \
	SPMV_FP64_MUL_INTERFACE SPMV_FP64_MUL_LATENCY SPMV_FP64_MUL_II \
	SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH SPMV_FP64_MUL_LANES \
	SPMV_FP64_MUL_CORE_COUNT SPMV_FP64_MUL_TOTAL_LANES \
	SPMV_PERFORMANCE_HTML SPMV_PIPELINE_HTML

ifneq ($(strip $(CONSTRUCTION_DIR)),)
VERILATOR_ROOT := $(shell dirname $$(dirname $$(command -v verilator)))/share/verilator
MODEL_DIR := $(CONSTRUCTION_DIR)/abi/verilator
CPPFLAGS += -DSPMV_INPUT_TRANSACTION_VERILATOR -I$(MODEL_DIR) -isystem $(VERILATOR_ROOT)/include \
	-isystem $(VERILATOR_ROOT)/include/vltstd \
	-DSPMV_INPUT_PROFILE_FROZEN \
	-DSPMV_PERFORMANCE_HTML_DEFAULT=$(SPMV_PERFORMANCE_HTML) \
	-DSPMV_PIPELINE_HTML_DEFAULT=$(SPMV_PIPELINE_HTML) \
	-DSPMV_INPUT_A_READER_COUNT_FROZEN=$(SPMV_INPUT_A_READER_COUNT) \
	-DSPMV_INPUT_X_READER_COUNT_FROZEN=$(SPMV_INPUT_X_READER_COUNT) \
	-DSPMV_INPUT_CTRL_READER_COUNT_FROZEN=$(SPMV_INPUT_CTRL_READER_COUNT) \
	-DSPMV_INPUT_HBM_CHANNEL_COUNT_FROZEN=$(SPMV_INPUT_HBM_CHANNEL_COUNT) \
	-DSPMV_INPUT_HBM_BASE_FROZEN=$(SPMV_INPUT_HBM_BASE) \
	-DSPMV_INPUT_HBM_BYTES_FROZEN=$(SPMV_INPUT_HBM_BYTES) \
	-DSPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES_FROZEN=$(SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES) \
	-DSPMV_INPUT_AXI_ADDR_WIDTH_FROZEN=$(SPMV_INPUT_AXI_ADDR_WIDTH) \
	-DSPMV_INPUT_AXI_DATA_WIDTH_FROZEN=$(SPMV_INPUT_AXI_DATA_WIDTH) \
	-DSPMV_INPUT_AXI_ID_WIDTH_FROZEN=$(SPMV_INPUT_AXI_ID_WIDTH) \
	-DSPMV_INPUT_MAX_OUTSTANDING_BURSTS_FROZEN=$(SPMV_INPUT_MAX_OUTSTANDING_BURSTS) \
	-DSPMV_INPUT_X_WINDOW_SIZE_DEFAULT=$(SPMV_INPUT_X_WINDOW_SIZE) \
	-DSPMV_CUPER_SLOT_COLUMN_BITS_FROZEN=$(SPMV_CUPER_SLOT_COLUMN_BITS) \
	-DSPMV_CUPER_SLOT_TAG_BITS_FROZEN=$(SPMV_CUPER_SLOT_TAG_BITS) \
	-DSPMV_CUPER_SLOT_ROW_BITS_FROZEN=$(SPMV_CUPER_SLOT_ROW_BITS) \
	-DSPMV_FP64_MUL_LATENCY_FROZEN=$(SPMV_FP64_MUL_LATENCY) \
	-DSPMV_FP64_MUL_II_FROZEN=$(SPMV_FP64_MUL_II) \
	-DSPMV_FP64_MUL_RESPONSE_FIFO_DEPTH_FROZEN=$(SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH) \
	-DSPMV_FP64_MUL_LANES_FROZEN=$(SPMV_FP64_MUL_LANES) \
	-DSPMV_FP64_MUL_CORE_COUNT_FROZEN=$(SPMV_FP64_MUL_CORE_COUNT) \
	-DSPMV_FP64_MUL_TOTAL_LANES_FROZEN=$(SPMV_FP64_MUL_TOTAL_LANES)
LDLIBS += $(MODEL_DIR)/libVSpmvInputTop.a \
	$(MODEL_DIR)/libverilated.a -pthread -latomic
endif

.PHONY: build-host build-simulation-host encode cuper-a-test encoding-html-test encoding-test input-html-test run

build-host: $(HOST_BIN)

build-simulation-host:
	@test -n "$(strip $(CONSTRUCTION_DIR))" || { echo 'build-simulation-host 缺少 CONSTRUCTION_DIR' >&2; exit 2; }
	@test -s "$(MODEL_DIR)/VSpmvInputTop.h"
	@test -s "$(MODEL_DIR)/libVSpmvInputTop.a"
	@test -s "$(MODEL_DIR)/libverilated.a"
	@$(MAKE) --no-print-directory "$(HOST_BIN)" CONSTRUCTION_DIR="$(CONSTRUCTION_DIR)" BUILD_DIR="$(BUILD_DIR)"
	@{ \
		printf '%s\n' 'HOST_FORMAT=12'; \
		printf 'CONFIG_FQCN=%s\n' "$$(sed -n 's/^CONFIG_FQCN=//p' "$(SPMV_PROFILE_FILE)")"; \
		printf '%s\n' 'ACCELERATOR_HOST_KIND=spmv' 'ACCELERATOR_HOST_ABI=spmv-input-report-v12' 'PROTOCOL_ABI=spmv-input-windowed-v11'; \
		printf 'SPMV_INPUT_A_READER_COUNT=%s\nSPMV_INPUT_X_READER_COUNT=%s\nSPMV_INPUT_CTRL_READER_COUNT=%s\n' "$(SPMV_INPUT_A_READER_COUNT)" "$(SPMV_INPUT_X_READER_COUNT)" "$(SPMV_INPUT_CTRL_READER_COUNT)"; \
		printf 'SPMV_INPUT_HBM_CHANNEL_COUNT=%s\nSPMV_INPUT_HBM_BASE=%s\nSPMV_INPUT_HBM_BYTES=%s\nSPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES=%s\n' "$(SPMV_INPUT_HBM_CHANNEL_COUNT)" "$(SPMV_INPUT_HBM_BASE)" "$(SPMV_INPUT_HBM_BYTES)" "$(SPMV_INPUT_HBM_CHANNEL_ALIGNMENT_BYTES)"; \
		printf 'SPMV_INPUT_AXI_ADDR_WIDTH=%s\nSPMV_INPUT_AXI_DATA_WIDTH=%s\nSPMV_INPUT_AXI_ID_WIDTH=%s\nSPMV_INPUT_MAX_OUTSTANDING_BURSTS=%s\n' "$(SPMV_INPUT_AXI_ADDR_WIDTH)" "$(SPMV_INPUT_AXI_DATA_WIDTH)" "$(SPMV_INPUT_AXI_ID_WIDTH)" "$(SPMV_INPUT_MAX_OUTSTANDING_BURSTS)"; \
		printf 'SPMV_INPUT_CONSUMER_COUNT=%s\nSPMV_INPUT_X_BROADCAST=%s\nSPMV_INPUT_CTRL_BROADCAST=%s\n' "$(SPMV_INPUT_CONSUMER_COUNT)" "$(SPMV_INPUT_X_BROADCAST)" "$(SPMV_INPUT_CTRL_BROADCAST)"; \
		printf 'SPMV_INPUT_X_WINDOW_SIZE=%s\nSPMV_INPUT_X_REPLICA_COUNT=%s\nSPMV_INPUT_X_BANK_COUNT=%s\nSPMV_INPUT_X_ELEMENT_WIDTH=%s\n' "$(SPMV_INPUT_X_WINDOW_SIZE)" "$(SPMV_INPUT_X_REPLICA_COUNT)" "$(SPMV_INPUT_X_BANK_COUNT)" "$(SPMV_INPUT_X_ELEMENT_WIDTH)"; \
		printf 'SPMV_CUPER_SLOT_ABI=%s\nSPMV_CUPER_SLOT_COLUMN_BITS=%s\nSPMV_CUPER_SLOT_TAG_BITS=%s\nSPMV_CUPER_SLOT_ROW_BITS=%s\n' "$(SPMV_CUPER_SLOT_ABI)" "$(SPMV_CUPER_SLOT_COLUMN_BITS)" "$(SPMV_CUPER_SLOT_TAG_BITS)" "$(SPMV_CUPER_SLOT_ROW_BITS)"; \
		printf 'SPMV_FP64_MUL_INTERFACE=%s\nSPMV_FP64_MUL_LATENCY=%s\nSPMV_FP64_MUL_II=%s\nSPMV_FP64_MUL_RESPONSE_FIFO_DEPTH=%s\nSPMV_FP64_MUL_LANES=%s\nSPMV_FP64_MUL_CORE_COUNT=%s\nSPMV_FP64_MUL_TOTAL_LANES=%s\n' "$(SPMV_FP64_MUL_INTERFACE)" "$(SPMV_FP64_MUL_LATENCY)" "$(SPMV_FP64_MUL_II)" "$(SPMV_FP64_MUL_RESPONSE_FIFO_DEPTH)" "$(SPMV_FP64_MUL_LANES)" "$(SPMV_FP64_MUL_CORE_COUNT)" "$(SPMV_FP64_MUL_TOTAL_LANES)"; \
		printf 'SPMV_PERFORMANCE_HTML=%s\nSPMV_PIPELINE_HTML=%s\n' "$(SPMV_PERFORMANCE_HTML)" "$(SPMV_PIPELINE_HTML)"; \
	} > "$(BUILD_DIR)/host.env"

encode: build-host
	@"$(HOST_BIN)" --encode "$(ENCODING)" "$${mainargs:-}"

cuper-a-test: build-host
	@"$(HOST_BIN)" --check-cuper-a "$${mainargs:-$(ENCODING_TEST_DATASET)}"

encoding-test: $(ENCODING_TEST_BIN)
	@"$(ENCODING_TEST_BIN)"

encoding-html-test: build-host
	@command -v node >/dev/null || { echo 'encoding-html-test 需要 node' >&2; exit 2; }
	@"$(HOST_BIN)" --encode "$(ENCODING)" "$${mainargs:-$(ENCODING_TEST_DATASET)}"
	@node "$(CURDIR)/encoding/html_report_test.js" \
		"$(SPMV_ENCODING_REPORT_DIR)/$(ENCODING)/$${mainargs:-$(ENCODING_TEST_DATASET)}.html"
	@node "$(CURDIR)/encoding/vector_html_report_test.js" \
		"$(SPMV_ENCODING_REPORT_DIR)/$(ENCODING)/$${mainargs:-$(ENCODING_TEST_DATASET)}-x.html"

input-html-test:
	@command -v node >/dev/null || { echo 'input-html-test 需要 node' >&2; exit 2; }
	@test -n "$(strip $(SPMV_INPUT_REPORT_DIR))" || { echo 'input-html-test 缺少 SPMV_INPUT_REPORT_DIR' >&2; exit 2; }
	@node "$(CURDIR)/input/input_html_test.js" \
		"$(SPMV_INPUT_REPORT_DIR)/performance.html" \
		"$(SPMV_INPUT_REPORT_DIR)/input-pipeline.html" \
		"$(SPMV_INPUT_REPORT_DIR)/timing-pipeline.html"

run: build-host
	@"$(HOST_BIN)" "$${mainargs:-}"

$(HOST_BIN): $(HOST_OBJECTS)
	$(CXX) $(CXXFLAGS) $(HOST_OBJECTS) $(LDLIBS) -o "$@"

$(ENCODING_TEST_BIN): $(ENCODING_TEST_OBJECT) $(ENCODING_OBJECTS)
	$(CXX) $(CXXFLAGS) $^ -o "$@"

$(BUILD_DIR)/%.o: %.cpp golden.hpp | $(BUILD_DIR)
	@mkdir -p "$(dir $@)"
	$(CXX) $(CPPFLAGS) $(CXXFLAGS) -MMD -MP -c "$<" -o "$@"

$(BUILD_DIR):
	mkdir -p "$@"

-include $(DEPFILES)
